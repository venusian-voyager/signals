{
    "name": "venusian-voyager/signals",
    "description": "The Voyager Hooks package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "laravel/serializable-closure": "^2.0",
        "venusian-voyager/macroable": "^0.9.0",
        "venusian-voyager/contracts": "^0.9.0",
        "venusian-voyager/collections": "^0.9.0",
        "venusian-voyager/nuts-and-bolts": "^0.9.0"
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Signals\\": ""
        },
        "files": [
            "Helpers/functions.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
